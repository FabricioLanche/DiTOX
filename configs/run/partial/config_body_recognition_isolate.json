{
  "images": {
    "images_folder_rel_path": "configs/dataset/COCO_Keypoints/images",
    "images_chunk": 10,
    "starts_from": 0,
    "limit": 20
  },
  "task": {
    "type": "body_recognition",
    "dataset_path": "configs/dataset/COCO_Keypoints/val.parquet",
    "images_dir": "configs/dataset/COCO_Keypoints/images",
    "limit": 20
  },
  "general": {
    "check_reports_for_problematic_models": true,
    "run_individual_passes": true,
    "report_file_base_rel_path": "results/tvm-results/partial/body_recognition_report_chunk_0_100.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 50,
    "name_filters": [],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr"
  },
  "hub": {
    "tags": ["body_recognition"],
    "tags_of_models_to_consider": ["body_recognition"],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "external_models_only": true,
    "external_model_names": [
      "MoveNet-Lightning",
      "MediaPipe-Pose",
      "RTMPose-S",
      "RTMPose-M",
      "YOLOv8n-Pose"
    ]
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm",
    "tvm": {
      "model_workers": 1,
      "threads_per_worker": 0
    }
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "directory": "results/checkpoints"
  }
}
