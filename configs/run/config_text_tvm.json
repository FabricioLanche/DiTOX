{
  "images": {
    "images_folder_rel_path": "configs/dataset/smoke",
    "images_chunk": 10,
    "starts_from": 0,
    "limit": 10
  },
  "general": {
    "check_reports_for_problematic_models": false,
    "run_individual_passes": true,
    "report_file_base_rel_path": "results/text_tvm_report_chunk_0_10.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 200,
    "name_filters": [],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr"
  },
  "hub": {
    "tags": ["text"],
    "tags_of_models_to_consider": ["text"],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "model_manifest_rel_path": "configs/models/manifest_text.json"
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm"
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "text": {
    "dataset": "squad_v2",
    "split": "validation",
    "prompt_template": "Context: {context} Question: {question}"
  }
}
