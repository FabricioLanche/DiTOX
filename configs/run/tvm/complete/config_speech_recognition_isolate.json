{
  "images": {
    "images_folder_rel_path": "configs/dataset/LibriSpeech",
    "images_chunk": 100,
    "starts_from": 0,
    "limit": 500
  },
  "task": {
    "type": "speech_recognition",
    "dataset_path": "configs/dataset/LibriSpeech/test.parquet",
    "limit": 500
  },
  "general": {
    "check_reports_for_problematic_models": true,
    "run_individual_passes": true,
    "report_file_base_rel_path": "results/tvm-results/complete/speech_recognition_isolate_report_chunk_0_10.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 50,
    "name_filters": [],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr",
    "problematic_models_report_file_base_rel_path": "results/tvm-results/complete/speech_recognition_explore_report_chunk_0_500.json"
  },
  "hub": {
    "tags": [
      "speech_recognition"
    ],
    "tags_of_models_to_consider": [
      "speech_recognition"
    ],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "external_models_only": true,
    "external_model_names": [
      "Whisper-Base-Encoder",
      "Wav2Vec2-Base-960h",
      "NeMo-Citrinet-512",
      "Whisper-Tiny-Encoder"
    ]
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm",
    "tvm": {
      "model_workers": 1,
      "threads_per_worker": 0
    }
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "directory": "results/tvm-results/complete/checkpoints/isolate"
  }
}
