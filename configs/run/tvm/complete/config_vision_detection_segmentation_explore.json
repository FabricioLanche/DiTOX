{
  "images": {
    "images_folder_rel_path": "configs/dataset/COCO",
    "images_chunk": 500,
    "starts_from": 0,
    "limit": 5000
  },
  "general": {
    "check_reports_for_problematic_models": false,
    "run_individual_passes": false,
    "report_file_base_rel_path": "results/tvm-results/complete/vision_detection_segmentation_explore_report_chunk_0_5000.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 200,
    "name_filters": [],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr"
  },
  "hub": {
    "tags": [
      "vision"
    ],
    "tags_of_models_to_consider": [
      "object detection segmentation"
    ],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "model_manifest_rel_path": "configs/models/models_manifest.json"
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm",
    "tvm": {
      "model_workers": 2,
      "threads_per_worker": 0
    }
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "directory": "results/tvm-results/complete/checkpoints/vision_detection_segmentation_explore"
  }
}
