{
  "images": {
    "images_folder_rel_path": "configs/dataset/COCO",
    "images_chunk": 10,
    "starts_from": 0,
    "limit": 50
  },
  "general": {
    "check_reports_for_problematic_models": false,
    "run_individual_passes": false,
    "report_file_base_rel_path": "results/tvm-results/partial/vision_classification_explore_report_chunk_0_50.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 200,
    "name_filters": [],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr",
    "exclude_name_filters": [
      "VGG 16-7",
      "VGG 16-bn-7",
      "VGG 16-fp32-12",
      "VGG 16-int8-12",
      "VGG 16-qdq-12",
      "VGG 19-7",
      "VGG 19-bn-7",
      "VGG 19-caffe2-7",
      "VGG 19-caffe2-8",
      "VGG 19-caffe2-9"
    ]
  },
  "hub": {
    "tags": [
      "vision"
    ],
    "tags_of_models_to_consider": [
      "classification"
    ],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "model_manifest_rel_path": "configs/models/models_manifest.json"
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm",
    "tvm": {
      "model_workers": 2,
      "threads_per_worker": 0
    }
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "directory": "results/tvm-results/partial/checkpoints/vision_classification_explore"
  }
}
