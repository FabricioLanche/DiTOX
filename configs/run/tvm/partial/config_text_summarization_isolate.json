{
  "images": {
    "images_folder_rel_path": "configs/dataset/COCO",
    "images_chunk": 5,
    "starts_from": 0,
    "limit": 5
  },
  "general": {
    "check_reports_for_problematic_models": true,
    "run_individual_passes": true,
    "report_file_base_rel_path": "results/tvm-results/partial/text_tvm_isolate_report_summarization_chunk_0_10.json",
    "skip_until_model_id": 0,
    "run_up_to_model_id": 200,
    "name_filters": [
      "T5-encoder-12"
    ],
    "match_filter_exact": true,
    "include_certainties": false,
    "enable_kt_on_one_dim_tensor": false,
    "backend": "tvmr",
    "problematic_models_report_file_base_rel_path": "results/tvm-results/partial/text_tvm_report_summarization_chunk_0_10.json"
  },
  "hub": {
    "tags": [
      "text"
    ],
    "tags_of_models_to_consider": [
      "text"
    ],
    "opset_bottom_threshold": 7,
    "cache_folder_rel_path": "models_cache",
    "model_manifest_rel_path": "configs/models/models_manifest.json"
  },
  "runtime": {
    "backend": "tvmr",
    "target": "llvm",
    "tvm": {
      "model_workers": 1,
      "threads_per_worker": 0
    }
  },
  "optimizer": {
    "enabled": true,
    "passes": []
  },
  "text": {
    "dataset": "configs/dataset/IMDB/test.parquet",
    "split": "test",
    "prompt_template": "{text}"
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "directory": "results/checkpoints/isolate"
  }
}
